# LiteLLM 统一模型配置（百炼 OpenAI 兼容）
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# PubMed 文献预检索
NCBI_EMAIL=
NCBI_API_KEY=

# 全文 RAG（可选，有默认值）
# FULLTEXT_MAX_ARTICLES=10
# FULLTEXT_MAX_CHARS=80000
# RAG_TOP_K=12
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
